---
import type { CollectionEntry } from 'astro:content'
import { Image } from 'astro:assets'
import Chip from '@/components/Chip.astro'

interface Props {
	work: CollectionEntry<'works'>['data']
}

const { work } = Astro.props
const tools = new Intl.ListFormat('en', { type: 'conjunction' }).format(work.tools)
---

<section>
	<div class='title'>
		<img class='icon' src={work.appIcon} alt={`${work.title} app icon`} width='56' height='56' />
		<h1>{work.title}</h1>
	</div>
	<h2>{work.description}</h2>
	<div>
		{work.chips.map((chip) => <Chip avatar={false}>{chip}</Chip>)}
	</div>
	<Image class='cover' src={work.cover} alt={work.coverAlt} widths={[640, 1024, 1536]} sizes='(width >= 1024px) 1024px, 100vw' loading='eager' fetchpriority='high' />
	<ul>
		<li>
			<p>📆 Duration</p>
			<p>{work.duration}</p>
		</li>
		<li>
			<p>⚙️ Tools</p>
			<p>{tools}</p>
		</li>
		<li>
			<p>🗂️ Type of Project</p>
			<p>{work.type}</p>
		</li>
	</ul>
</section>

<style>
	section {
		padding-top: 2.5rem;
		padding-bottom: 5rem;
	}
	.title {
		display: flex;
		align-items: center;
		gap: 1rem;
	}
	.icon {
		height: clamp(2.5rem, 8vw, 3.5rem);
		aspect-ratio: 1/1;
	}
	h1 {
		font-family: var(--font-led);
		color: var(--primary-400);
		font-weight: 400;
		text-transform: uppercase;
	}
	h2 {
		margin-block: 1rem;
		font-weight: 500;
		font-size: var(--body-large);
	}
	.cover {
		width: 100%;
		height: auto;
		margin-block: 1.5rem;
	}
	ul {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
	}
	li p:first-child {
		color: var(--neutral-300);
	}
	@media (width >= 768px) {
		ul {
			grid-template-columns: repeat(3, 1fr);
		}
	}
</style>
