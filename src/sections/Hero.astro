---
import { Image } from 'astro:assets'
import rubenFlip from '@/assets/img/ruben-flip.webp'
import castilloFlip from '@/assets/img/castillo-flip.webp'
---

<section class='wrapper'>
	<h1>Hello! 👋 I’m</h1>
	<div>
		<Image
			class='ruben-flip'
			src={rubenFlip}
			alt='airport flipping letters displaying Ruben word'
			widths={[550, 1100]}
			sizes='(width >= 1024px) 660px, 65vw'
			loading='eager'
			fetchpriority='high'
		/>
		<Image
			class='castillo-flip'
			src={castilloFlip}
			alt='airport flipping letters displaying Castillo word'
			widths={[850, 1700]}
			sizes='(width >= 1024px) 1024px, 100vw'
			loading='eager'
			fetchpriority='high'
		/>
	</div>
	<p>
		A <span class='accent'>UX/UI designer</span> 💡 with knowledge in <span class='accent'>Full Stack</span> 💻<br />
		Currently working at Boehringer Ingelheim 💊 as a Lead UX/UI<br />
		On the side, I’m a casual chef 👨🏻‍🍳 gamer 🕹 and traveler ✈️
	</p>
</section>

<style>
	section {
		padding-block: 4rem;
	}
	h1 {
		padding-bottom: 1.5rem;
	}
	img {
		margin-left: clamp(-50px, -4.8vw, 0px);
	}
	.ruben-flip {
		scale: 0.64705;
		transform-origin: left;
		height: auto;
	}

	.castillo-flip {
		height: auto;
	}
	.accent {
		color: var(--primary-300);
	}
	p {
		padding-top: 1.5rem;
	}
</style>
