---
import { getCollection } from 'astro:content'
import RepoCard from '@/components/RepoCard.astro'

const repos = (await getCollection('repos')).sort((a, b) => a.data.order - b.data.order)
---

<section>
	<ul>
		{
			repos.map((repo) => (
				<li>
					<RepoCard repo={repo.data} />
				</li>
			))
		}
	</ul>
</section>

<style>
	section {
		padding-block: 2rem;
	}
	ul {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(336px, 1fr));
		gap: 1.5rem;
	}
</style>
