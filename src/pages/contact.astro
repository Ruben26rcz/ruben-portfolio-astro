---
import { Image } from 'astro:assets'
import Layout from '@/layouts/Layout.astro'
import airplane from '@/assets/img/airplane-departure-emoji.png'

const skillGroups = [
	{
		title: 'Soft Skills',
		skills: [
			{ name: 'Communication', level: 4 },
			{ name: 'Leadership', level: 4 },
			{ name: 'Time Management', level: 4 },
			{ name: 'Curiosity', level: 5 },
		],
	},
	{
		title: 'Hard Skills',
		skills: [
			{ name: 'Visual Design', level: 5 },
			{ name: 'Programming', level: 4 },
			{ name: 'Research', level: 3 },
			{ name: '3D Modeling', level: 3 },
		],
	},
]
const maxLevel = 5
---

<Layout title='Ruben UX/UI - Contact' description='A UX/UI designer based in Barcelona'>
	<main id='main' class='wrapper'>
		<h1 class='sr-only'>Contact</h1>
		<section>
			<div class='boarding-pass__header'>
				<div class='boarding-pass__place'>
					<p class='acronym'>UXI</p>
					<p class='acronym-description'>UX/UI Designer</p>
				</div>
				<Image class='airplane' src={airplane} alt='airplane emoji' height={72} densities={[1, 2]} />
				<div>
					<p class='acronym'>FSD</p>
					<p class='acronym-description'>Fullstack Developer</p>
				</div>
			</div>
			<div class='boarding-pass__content'>
				<div class='boarding-pass__info'>
					<ul>
						<li>
							<p class='label'>Name</p>
							<p>Rubén Castillo</p>
						</li>
						<li>
							<p class='label'>From 📍</p>
							<p>Barcelona</p>
						</li>
						<li>
							<p class='label'>email ✉️</p>
							<p><a class='email' href='mailto:ruben26rcz@gmail.com'>ruben26rcz@gmail.com</a></p>
						</li>
					</ul>
					<img class='qr' src='/svg/qr-code-rounded.svg' alt='QR code with contact details' />
				</div>

				{
					skillGroups.map(({ title, skills }) => (
						<div class='skills'>
							<h2>{title}</h2>
							{skills.map(({ name, level }) => (
								<div class='skill'>
									<div class='bullets' role='img' aria-label={`${name}: ${level} out of ${maxLevel}`}>
										{Array.from({ length: maxLevel }, (_, i) => (
											<span class={i < level ? 'bullet-true' : 'bullet-false'} />
										))}
									</div>
									<p aria-hidden='true'>{name}</p>
								</div>
							))}
						</div>
					))
				}
			</div>
		</section>
	</main>
</Layout>

<style>
	h2 {
		font-size: var(--body-medium);
		padding-bottom: 1rem;
	}
	.boarding-pass__header {
		padding: 1.5rem;
		background-color: var(--primary-400);
		border-radius: 1.5rem 1.5rem 0 0;
		color: var(--neutral-900);
		display: flex;
		justify-content: space-between;
	}
	.acronym {
		font-size: var(--title-large);
		text-align: center;
		font-weight: 900;
	}
	.acronym-description {
		font-size: var(--body-small);
		text-align: center;
	}
	.airplane {
		height: 72px;
	}
	.boarding-pass__content {
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: 1.5rem;
		background-color: var(--neutral-00);
		border-radius: 0 0 1.5rem 1.5rem;
		color: var(--neutral-900);
	}
	.boarding-pass__info {
		display: flex;
		justify-content: space-between;
	}
	.label {
		font-weight: 700;
		font-size: var(--body-small);
	}
	.skills {
		margin-top: 2rem;
	}
	.skills__title {
		margin-bottom: 1rem;
	}
	.skill {
		margin-bottom: 1.5rem;
		& p {
			font-size: var(--body-small);
		}
	}
	.bullets {
		display: grid;
		grid-template-columns: 1fr 1fr 1fr 1fr 1fr;
		gap: 0.5rem;
		margin-bottom: 0.5rem;
	}
	.bullet-true {
		height: 7px;
		border-radius: 100px;
		background-color: var(--primary-500);
	}
	.bullet-false {
		height: 7px;
		border-radius: 100px;
		background-color: var(--neutral-100);
	}
	.email {
		text-decoration: underline;
		text-underline-offset: 0.15rem;
		overflow-wrap: anywhere;
	}
	.qr {
		max-height: 200px;
		height: 20vw;
	}
</style>
