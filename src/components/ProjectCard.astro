---
import type { CollectionEntry } from 'astro:content'
import { Image } from 'astro:assets'
import Chip from '@/components/Chip.astro'
import arrowDiagonal from '@/assets/svg/diagonal-arrow.svg'
import '../styles/animations.css'
interface Props {
	work: CollectionEntry<'works'>
}

const { id: slug } = Astro.props.work
const { title, chips, description, cover, coverAlt } = Astro.props.work.data
---

<a href={`/work/${slug}`} class='project-card'>
	<Image class='card-image' src={cover} alt={coverAlt} widths={[480, 960]} sizes='(width >= 768px) 480px, 100vw' />
	<h2>{title.toUpperCase()} <img src={arrowDiagonal.src} alt='' width='20' height='20' /></h2>
	<div class='chips'>
		{chips.map((chip) => <Chip avatar={false}>{chip}</Chip>)}
	</div>
	<p class='date'>{description}</p>
</a>

<style>
	.project-card {
		display: block;
		height: 100%;
		background-color: var(--neutral-800);
		padding: 1rem;
		border-radius: 0.5rem;
		&:hover {
			background-color: var(--neutral-700);
			h2 {
				animation-name: led-animation;
				animation-duration: 0.6s;
				animation-timing-function: ease-in;
				animation-iteration-count: 1;
				animation-direction: normal;
				animation-fill-mode: forwards;
			}
		}
	}
	h2 {
		display: flex;
		gap: 0.5rem;
		font-family: var(--font-led);
		font-weight: 400;
		color: var(--primary-400);
		& img {
			width: var(--title-small);
			height: var(--title-small);
			margin-top: 0.5rem;
		}
	}
	.card-image {
		object-fit: cover;
		margin-bottom: 2rem;
		height: 344px;
		width: 100%;
	}
	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	h2,
	div {
		padding-bottom: 1rem;
	}
</style>
