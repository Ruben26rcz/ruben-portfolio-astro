---
import { isCurrent, navLinks } from '@/lib/nav'

const currentDate = new Date()
const currentYear = currentDate.getFullYear()
---

<footer class='wrapper'>
	<hr />
	<div class='footer-content'>
		<nav aria-label='Social'>
			<ul>
				<li><a href='/documents/cv-ruben-castillo ux-ui-2024.pdf' target='_blank' rel='noopener'>Resume<span class='sr-only'> (opens in a new tab)</span></a></li>
				<li><a href='https://www.linkedin.com/in/rubenzambrana' target='_blank' rel='noopener'>LinkedIn<span class='sr-only'> (opens in a new tab)</span></a></li>
				<li><a href='https://www.github.com/Ruben26rcz' target='_blank' rel='noopener'>Github<span class='sr-only'> (opens in a new tab)</span></a></li>
			</ul>
		</nav>
		<nav aria-label='Footer'>
			<ul>
				{
					navLinks.map(({ href, label }) => {
						const current = isCurrent(href, Astro.url.pathname)
						return (
							<li>
								<a class:list={{ active: current }} href={href} aria-current={current ? 'page' : undefined}>
									{label}
								</a>
							</li>
						)
					})
				}
			</ul>
		</nav>
	</div>
	<div class='signature'>
		<p>Coded with 💛 by Rubén</p>
		<p>© {currentYear}</p>
	</div>
</footer>

<style>
	footer {
		height: var(--footer-height);
		padding-block: 4rem;
	}
	hr {
		margin-bottom: 4rem;
		border: 1px solid var(--neutral-700);
	}
	.footer-content {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2.5rem;
		padding-bottom: 3rem;
	}

	nav ul {
		display: flex;
		gap: 1.5rem;
	}
	li:hover {
		color: var(--primary-400);
	}

	.active {
		color: var(--primary-400);
	}

	.signature {
		text-align: center;
		font-size: var(--body-small);
	}

	.signature p:first-child {
		padding-bottom: 0.5rem;
	}

	@media (width >= 768px) {
		.footer-content {
			flex-direction: row;
			justify-content: space-between;
		}
	}
</style>
