---
interface Props {
	title: string
}

const { title } = Astro.props
---

<section class='case-section'>
	<h3>{title}</h3>
	<slot />
</section>

<style>
	h3 {
		font-family: 'TexasLED';
		text-transform: uppercase;
		font-weight: 500;
		color: var(--primary-500);
		padding-bottom: 1rem;
		font-size: var(--title-small);
	}
	.case-section:not(:last-child) {
		padding-bottom: 3rem;
	}
</style>
