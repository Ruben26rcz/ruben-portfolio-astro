---
import HambIcon from '@/components/HambIcon.astro'
import { isCurrent, navLinks } from '@/lib/nav'
---

<div class='nav-container'>
	<button class='hamb-icon' aria-label='Menu' aria-expanded='false' aria-controls='main-nav'>
		<HambIcon />
	</button>
	<nav id='main-nav' aria-label='Main'>
		<ul>
			{
				navLinks.map(({ href, label }) => {
					const current = isCurrent(href, Astro.url.pathname)
					return (
						<li>
							<a class:list={{ active: current }} href={href} aria-current={current ? 'page' : undefined}>
								{label}
							</a>
						</li>
					)
				})
			}
		</ul>
	</nav>
	<div class='background-overlay'></div>
</div>

<style>
	.nav-container {
		display: grid;
		place-items: center;
	}
	button {
		background-color: unset;
		border: none;
		padding: 0;
	}
	nav {
		position: absolute;
		top: var(--header-height);
		left: 0;
		width: 100vw;
		padding-block: 3rem;
		transform: scale(1, 0);
		transform-origin: top center;
		visibility: hidden;
		transition:
			transform 0.3s ease-in-out,
			visibility 0.3s;
		z-index: 999;
	}

	.show-nav {
		background-color: var(--neutral-950);
		transform: scale(1, 1);
		visibility: visible;

		& ul {
			top: 0;
			opacity: 1;
			transition: opacity 0.3s ease-in-out;
			transition-delay: 200ms;
		}
	}
	.show-background-overlay {
		position: fixed;
		top: var(--header-height);
		left: 0;
		width: 100vw;
		height: 100vh;
		background-color: rgba(0, 0, 0, 0.5);
		z-index: 2;
		-webkit-backdrop-filter: blur(5px);
		backdrop-filter: blur(5px);
	}

	ul {
		display: flex;
		text-align: center;
		flex-direction: column;
		gap: 2rem;
		font-size: var(--title-small);
		opacity: 0;
	}
	li:hover {
		color: var(--primary-400);
	}
	.active {
		color: var(--primary-400);
	}

	@media (width >= 1024px) {
		.hamb-icon {
			display: none;
		}

		nav {
			transform: scale(1, 1);
			visibility: visible;
			background-color: unset;
			position: static;
			height: unset;
			width: unset;
			transition: unset;

			& ul {
				opacity: 1;
			}
		}

		ul {
			text-align: start;
			flex-direction: row;
			font-size: var(--body-medium);
		}
		.show-background-overlay {
			all: unset;
		}
	}
</style>

<script>
	const button = document.querySelector<HTMLButtonElement>('.hamb-icon')
	const nav = document.querySelector<HTMLElement>('#main-nav')
	const overlay = document.querySelector<HTMLElement>('.background-overlay')
	const icon = button?.querySelector('.ham')

	function setMenu(open: boolean) {
		if (!button || !nav || !overlay) return
		button.setAttribute('aria-expanded', String(open))
		icon?.classList.toggle('active', open)
		nav.classList.toggle('show-nav', open)
		overlay.classList.toggle('show-background-overlay', open)
		document.body.classList.toggle('no-scroll', open)
	}

	const isOpen = () => button?.getAttribute('aria-expanded') === 'true'

	button?.addEventListener('click', () => setMenu(!isOpen()))
	overlay?.addEventListener('click', () => setMenu(false))

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && isOpen()) {
			setMenu(false)
			button?.focus()
		}
	})

	// Close the mobile menu when resizing to desktop
	window.matchMedia('(width >= 1024px)').addEventListener('change', (event) => {
		if (event.matches) setMenu(false)
	})
</script>
